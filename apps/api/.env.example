# Fake values: copy to .env and replace. Never commit the real file.
# 32+ bytes of entropy, e.g. `openssl rand -base64 48`
PANEL_SECRET_KEY=change-me-change-me-change-me-change-me-0000
# Public origin of the panel (used for Origin checks and cookies)
PANEL_ORIGIN=http://localhost:4200
# Where the SQLite database lives (outside the repo)
# PANEL_DATA_DIR=~/.local/share/agents-panel
# Root of the per-chat git worktrees: <root>/<project>/<slug>
# PANEL_WORKTREES_DIR=~/wt
# Where projects added from GitHub are cloned: <dir>/<project>
# PANEL_PROJECTS_DIR=~/proyectos
# Minimum free disk (GB) required to start a clone
# PANEL_MIN_FREE_DISK_GB=10
# Script run by the Kyro update (default: scripts/vm/08-kyro-update.sh of this repo)
# PANEL_KYRO_UPDATE_SCRIPT=
# Session lifetimes in seconds
# PANEL_SESSION_IDLE_TTL_SECONDS=1800
# PANEL_SESSION_ABSOLUTE_TTL_SECONDS=43200
# Sessions the autopilot may open for one sprint before it stops the work (default 6)
# PILOT_MAX_SESSIONS_PER_SPRINT=6
# Minutes a project's validate command may run before the pilot stops it (default 15)
# PILOT_VALIDATE_TIMEOUT_MINUTES=15
HOST=127.0.0.1
PORT=3000
