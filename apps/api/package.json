{
  "name": "@agents-panel/api",
  "version": "0.0.0",
  "private": true,
  "description": "agents-panel backend: Fastify API",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "^0.12.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@agents-panel/shared": "0.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.12.5",
    "otpauth": "^9.5.2",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7"
  }
}
